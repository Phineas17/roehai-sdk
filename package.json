{
  "name": "roehai-sdk",
  "version": "1.0.0",
  "description": "SDK officiel RoehAI — intégrez les agents IA (Aria, Léa, Maya) dans vos applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "roehai",
    "ai",
    "agent",
    "aria",
    "lea",
    "vocal",
    "whatsapp",
    "automation"
  ],
  "author": "RoehAI <dev@roehai.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phineas17/roehai-sdk"
  },
  "homepage": "https://dev.roehai.com",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
